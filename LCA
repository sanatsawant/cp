
int n,m;
vector<vector<int>> g,par;
vector<int> depth;

void dfs(int u,int p,int d){
    depth[u]=d;
    par[u][0]=p;

    for(auto v:g[u]){
        if(v==p) continue;
        dfs(v,u,d+1);
    }
}

void buildpar(){
    for(int j=1;j<m;j++){
        for(int i=0;i<n;i++){
            if(par[i][j-1]==-1) continue;
            par[i][j]=par[par[i][j-1]][j-1];
        }
    }
}

int lca(int u,int v){
    if(depth[u]>depth[v]) swap(u,v);

    // Bring both nodes to the same depth
    int diff=depth[v]-depth[u];

    for(int i=0;i<m;i++){
        if(diff & (1<<i)){
            v=par[v][i];
        }
    }

    if(u==v) return u;

    // Lift both nodes together
    for(int i=m-1;i>=0;i--){
        if(par[u][i]!=par[v][i]){
            u=par[u][i];
            v=par[v][i];
        }
    }

    return par[u][0];
}

// Initialization
void init(int n_){
    n=n_;
    m=__lg(n)+1;

    g.assign(n,{});
    depth.assign(n,0);
    par.assign(n,vector<int>(m,-1));

    // Add edges to g

    dfs(0,-1,0);
    buildpar();
}
