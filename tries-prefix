class Solution {
public:
    struct TrieNode{
        TrieNode* child[10];
    };
    TrieNode* getNode(){
        TrieNode* t=new TrieNode;
        for(int i=0;i<10;i++){
            t->child[i]=nullptr;
        }
        return t;
    }
    void insert(string s,TrieNode* root){
        TrieNode* t=root;
        for(auto& x:s){
            int y=x-'0';
            if(!t->child[y]) t->child[y]=getNode();
            t=t->child[y];
        }
    }
    int ans(string s,TrieNode* root){
        TrieNode* t=root;
        int len=0;
        for(auto&x:s){
            if(t->child[x-'0']){
                len++;
                t=t->child[x-'0'];
            }
            else break;
        }
        return len;
    }
    int longestCommonPrefix(vector<int>& a, vector<int>& b) {
        TrieNode* root=getNode();
        for(auto& x:a){
            insert(to_string(x),root);
        }
        int fa=0;
        for(auto&x:b){
            fa=max(fa,ans(to_string(x),root));
        }
        return fa;
    }
};
